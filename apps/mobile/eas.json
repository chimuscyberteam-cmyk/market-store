{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://market-store-api.onrender.com",
        "EXPO_PUBLIC_CLOUDINARY_CLOUD": "rxept7vj",
        "EXPO_PUBLIC_CLOUDINARY_PRESET": "market-store-unsigned"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
